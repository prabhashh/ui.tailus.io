[Unit]
Description=Uptime Monitor - Prober (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uptime
Group=uptime
EnvironmentFile=/etc/uptime-monitor/uptime-monitor.env
# %i is the instance suffix from `systemctl enable uptime-prober@1`, `@2`, ...
# — run several instances per box to use all cores (see docs/OPERATIONS.md
# capacity planning); each gets a distinct UPTIME_INSTANCE_ID below so their
# NATS durable consumer names and DNS caches don't collide.
Environment=UPTIME_INSTANCE_ID=%H-prober-%i
# Single-digit instance numbers only (":909%i" -> :9091.."9099"); for more
# than 9 prober instances on one host, switch to Docker/systemd-nspawn
# where each gets its own network namespace instead of juggling ports.
Environment=UPTIME_METRICS_ADDR=:909%i
ExecStart=/opt/uptime-monitor/bin/prober
Restart=always
RestartSec=2
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
