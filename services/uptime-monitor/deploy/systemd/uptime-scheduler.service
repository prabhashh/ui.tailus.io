[Unit]
Description=Uptime Monitor - Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uptime
Group=uptime
EnvironmentFile=/etc/uptime-monitor/uptime-monitor.env
ExecStart=/opt/uptime-monitor/bin/scheduler
Restart=always
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
