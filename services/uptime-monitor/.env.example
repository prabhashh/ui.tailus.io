# Copy to /etc/uptime-monitor/uptime-monitor.env on each VPS and fill in
# real values. Referenced by deploy/systemd/*.service via EnvironmentFile.

# --- Identity (set per-instance) ---
UPTIME_REGION=us-east
UPTIME_INSTANCE_ID=

# --- Postgres ---
UPTIME_POSTGRES_DSN=postgres://uptime:CHANGE_ME@10.0.0.10:5432/uptime?sslmode=require
UPTIME_POSTGRES_MAX_CONNS=20
UPTIME_POSTGRES_MIN_CONNS=2

# --- Redis ---
UPTIME_REDIS_ADDR=10.0.0.11:6379
UPTIME_REDIS_PASSWORD=CHANGE_ME
UPTIME_REDIS_DB=0

# --- NATS / JetStream ---
UPTIME_NATS_URL=nats://10.0.0.12:4222
UPTIME_NATS_CREDS_FILE=
UPTIME_JOB_STREAM=CHECKS
UPTIME_RESULT_STREAM=RESULTS

# --- Worker pool (prober only) ---
UPTIME_WORKER_POOL_SIZE=500
UPTIME_QUARANTINE_POOL_SIZE=50

# --- Adaptive timeout ---
UPTIME_DEFAULT_TIMEOUT=5s
UPTIME_MIN_TIMEOUT=2s
UPTIME_MAX_TIMEOUT=30s

# --- HTTP transport tuning (prober only) ---
UPTIME_MAX_IDLE_CONNS=4000
UPTIME_MAX_IDLE_CONNS_PER_HOST=4
UPTIME_IDLE_CONN_TIMEOUT=90s
UPTIME_DNS_CACHE_TTL=30s

# --- Observability ---
UPTIME_METRICS_ADDR=:9090
UPTIME_OTLP_ENDPOINT=

# --- API only ---
UPTIME_API_ADDR=:8080

# --- resultprocessor only (email notification channel) ---
UPTIME_SMTP_HOST=
UPTIME_SMTP_PORT=587
UPTIME_SMTP_USERNAME=
UPTIME_SMTP_PASSWORD=
UPTIME_SMTP_FROM=alerts@yourdomain.com
